# Copy this file to .env for local use. On Cloudflare Pages, add these two
# as "Environment variables" instead (Settings -> Variables and Secrets).
#
# Both values are PUBLIC by design (they ship inside the website). Row Level
# Security in the database is what protects your data.
#
# NEVER put the Supabase "service_role" / "secret" key, a database password,
# Resend key or WhatsApp token in this file or in any VITE_ variable.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
